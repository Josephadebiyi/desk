{
  "name": "ziondesk-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "i18n:check": "node scripts/check-i18n.mjs",
    "start": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "flw:plans": "tsx scripts/flw-plans.ts",
    "promo": "bash promo/build.sh",
    "promo:voice": "node promo/voice.mjs",
    "promo:stills": "node promo/stills.mjs",
    "build:hostinger": "VITE_API_URL=${VITE_API_URL:-https://desk-noae.onrender.com} vite build && cd dist && rm -f ../ziondesk-hostinger.zip && zip -qr ../ziondesk-hostinger.zip . -x '*.DS_Store' && echo '→ ziondesk-hostinger.zip (upload its contents to public_html)'",
    "build:admin": "VITE_ADMIN_ONLY=1 VITE_API_URL=${VITE_API_URL:-https://desk-noae.onrender.com} vite build --outDir dist-admin --emptyOutDir && sed -i '' 's|<If \"%{HTTP_HOST} =~ /^admin\\\\./\">|<If \"true\">|' dist-admin/.htaccess && cd dist-admin && rm -f ../ziondesk-admin.zip && zip -qr ../ziondesk-admin.zip . -x '*.DS_Store' && echo '→ ziondesk-admin.zip (upload its contents to the admin domain folder)'",
    "test:design": "tsx --test server/design/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@expo-google-fonts/abril-fatface": "0.4.1",
    "@expo-google-fonts/alex-brush": "0.4.1",
    "@expo-google-fonts/anton": "0.4.2",
    "@expo-google-fonts/archivo-black": "0.4.1",
    "@expo-google-fonts/bebas-neue": "0.4.1",
    "@expo-google-fonts/big-shoulders-display": "0.2.3",
    "@expo-google-fonts/bodoni-moda": "0.4.2",
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/cinzel": "0.4.2",
    "@expo-google-fonts/cormorant-garamond": "0.4.1",
    "@expo-google-fonts/dm-serif-display": "0.4.2",
    "@expo-google-fonts/dm-serif-text": "0.4.1",
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo-google-fonts/great-vibes": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/marcellus": "0.4.1",
    "@expo-google-fonts/montserrat": "0.4.2",
    "@expo-google-fonts/oswald": "0.4.2",
    "@expo-google-fonts/pinyon-script": "0.4.1",
    "@expo-google-fonts/playfair-display": "0.4.2",
    "@expo-google-fonts/poppins": "0.4.1",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@expo-google-fonts/syne": "0.4.2",
    "@expo-google-fonts/unbounded": "0.4.1",
    "@expo-google-fonts/yeseva-one": "0.4.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "2.117.2",
    "express": "5.2.1",
    "framer-motion": "14.0.0",
    "html-to-image": "1.11.13",
    "konva": "10.9.0",
    "lucide-react": "1.51.0",
    "opentype.js": "2.0.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "19.3.2",
    "react-router-dom": "7.18.4",
    "stripe": "23.0.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.13.3",
    "@types/opentype.js": "1.3.10",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
