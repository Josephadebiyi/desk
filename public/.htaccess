# ZionDesk on Hostinger (Apache): static site; the API runs on Render (see VITE_API_URL).
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.ziondesk.com → ziondesk.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Apple Pay verification: Hostinger's zip extraction skips dot-folders, so the file also lives at the
  # site root and is served at the address Paystack/Apple check.
  RewriteRule ^\.well-known/apple-developer-merchantid-domain-association$ /apple-developer-merchantid-domain-association [L]

  # Single-page app: every route that isn't a real file is served by index.html
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Apple Pay domain verification (Paystack): served as-is with the content type Apple/Paystack expect.
<Files "apple-developer-merchantid-domain-association">
  ForceType application/text
</Files>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Admin domain stays out of search engines
  <If "%{HTTP_HOST} =~ /^admin\./">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  # Hashed build assets never change → cache for a year; HTML always fresh
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
