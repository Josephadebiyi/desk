# Copy to .env for local development (never commit .env). On Render, set these under Environment.
# Without the Supabase values the app runs in "preview mode" on demo data in the browser.

# ── Public site address (no trailing slash) ──
SITE_URL=http://localhost:5173

# ── Supabase (Project Settings → API) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # server only — never expose in the browser
SUPABASE_AUTH_HOOK_SECRET=           # Authentication → Hooks → Send Email (v1,whsec_…)

# ── Resend (resend.com → API Keys; verify your domain first) ──
RESEND_API_KEY=
EMAIL_FROM="ZionDesk <hello@yourdomain.com>"
EMAIL_REPLY_TO=

# ── Ellen (AI). Claude: Ellen, AI flyers and birthday prayers ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Flutterwave (dashboard → Settings → API keys; Webhooks) ──
# Paystack: plan billing + paid extras (NGN for Nigerian churches, USD otherwise). Webhook URL:
#   https://<api>/api/payments/paystack-webhook   (signed with the secret key — no separate hash)
PAYSTACK_SECRET_KEY=            # Nigeria account (NGN, + USD when enabled)
PAYSTACK_PUBLIC_KEY=
# Other countries' Paystack business accounts (optional; each charges its own currency)
PAYSTACK_GH_SECRET_KEY=         # Ghana (GHS)
PAYSTACK_KE_SECRET_KEY=         # Kenya (KES)
PAYSTACK_ZA_SECRET_KEY=         # South Africa (ZAR)
PAYSTACK_CI_SECRET_KEY=         # Côte d'Ivoire (XOF)
# Stripe (Lithuanian account): EUR / GBP / USD for everyone outside Paystack's African countries.
# Use a restricted key (rk_live_…). Webhook: https://<api>/api/payments/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutterwave: online giving + subscriptions started before Paystack
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=          # the "Secret hash" you type on the webhook settings page
FLW_PLATFORM_FEE=0         # share ZionDesk keeps from each gift (0.02 = 2%)
FLW_PLAN_ESSENTIALS=       # from: npm run flw:plans
FLW_PLAN_PLUS=
FLW_PLAN_MAX=

# ── Optional: SMS / WhatsApp via Twilio ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=      # MG… (Twilio → Messaging → Services). Preferred over TWILIO_SMS_FROM
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=              # your WhatsApp-approved Twilio number, e.g. +14155551234
TWILIO_WHATSAPP_CONTENT_SID=       # HX… approved template with body {{1}} (Twilio → Messaging → Content Template Builder)

# ── Protects /api/cron/* (any long random string) ──
CRON_SECRET=
