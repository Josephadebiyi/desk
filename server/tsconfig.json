{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["./**/*.ts", "../scripts/*.ts", "../api/*.ts", "../src/emails/*.ts", "../src/i18n/locales/**/*.ts"]
}
